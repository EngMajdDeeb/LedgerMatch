# Copy this file to .env and fill in real values. .env is git-ignored.

# Django
DJANGO_SECRET_KEY=change-me-to-a-random-secret-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Damascus

# OpenAI
OPENAI_API_KEY=sk-...
# Vision-capable model used to extract the pharmacy's sales-image table.
OPENAI_VISION_MODEL=gpt-4o-mini
# Text model used to run the El-Bayan vs image comparison.
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=120
